# =========================================================================
# BRAINSCAN AI - BACKEND ENVIRONMENT CONFIGURATION TEMPLATE
# =========================================================================
# Copy this file to '.env' and modify the values for your environment.

# 1. DATABASE CONFIGURATION
# Format: postgresql://[user]:[password]@[host]:[port]/[database]
# For Local Docker Dev fallback default: postgresql://postgres:passwordnabilaesd@db:5432/tumordb
# For Hostinger VPS production, set to your host credentials (e.g. localhost or external DB ip)
DATABASE_URL=postgresql://postgres:passwordnabilaesd@db:5432/tumordb

# 2. SECURITY CONFIGURATION
# SECRET_KEY is used to sign JWT Auth Tokens. Run 'openssl rand -hex 32' to generate a secure secret.
SECRET_KEY=project_tumor_otak

# 3. CORS CONFIGURATION
# Comma-separated list of origins allowed to call this API.
# Use '*' to allow all (for development only). 
# For Hostinger production, change to your specific frontend URL (e.g., http://yourdomain.com)
CORS_ORIGINS=*
